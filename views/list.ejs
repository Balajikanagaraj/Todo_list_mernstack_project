<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Todo List</title>
  <link rel="stylesheet" href="css/style.css">
  <script>
    function deleteTask(taskId, checkbox) {
      const taskElement = document.getElementById(`task-${taskId}`);
      if (checkbox.checked) {
        // Strike through the task
        taskElement.querySelector('p').style.textDecoration = 'line-through';
        
        // Delete the task from the database
        fetch(`/delete/${taskId}`, {
          method: 'DELETE'
        })
        .then(response => {
          if (response.ok) {
            // Hide the task from UI after a slight delay to see the strike-through
            setTimeout(() => {
              taskElement.style.display = 'none'; 
            }, 200); // Delay to let the strike-through effect be visible
          } else {
            console.error('Failed to delete task');
          }
        })
        .catch(error => {
          console.error('Error:', error);
        });
      }
    }
  </script>
</head>
<body>
  <div class="box">
    <h1>Todo List</h1>
    <% for (var i = 0; i < dayej.length; i++) { %>
      <div class="item" id="task-<%= dayej[i]._id %>">
        <input type="checkbox" onchange="deleteTask('<%= dayej[i]._id %>', this)">
        <p><%= dayej[i].name %></p>
      </div>
    <% } %>
    <form action="/" method="POST">
      <div class="input-container">
        <input type="text" name="ele1" placeholder="Enter the Task" required>
        <button type="submit">+</button>
      </div>
    </form>
  </div>
</body>
</html>
